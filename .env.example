# Copy to backend/.env (the backend + sim worker load backend/.env and backend/.env.local)

# ── MongoDB ─────────────────────────────────────────────────────────
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=simulacra

# ── Local LLM (OpenAI-compatible server) ────────────────────────────
# Default: prism-ml/Ternary-Bonsai-27B-mlx-2bit served by `mlx_lm.server --port 8080`
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=prism-ml/Ternary-Bonsai-27B-mlx-2bit
# Local servers ignore the key; set a real key only for hosted APIs (e.g. K2).
LLM_API_KEY=local
# Qwen3-style "thinking" (much slower; off by default)
# LLM_ENABLE_THINKING=false

# Sim worker: "llm" (local model + scripted fallback) or "scripted" (no LLM)
# SIM_ENGINE=llm
# SIM_ROUNDS=9
# SIM_ROUND_SECONDS=25

# Optional: enable swarm mode (two-phase NPC rounds)
# SWARM=true

# Optional: allowed CORS origins (comma-separated for multiple)
# ALLOWED_ORIGINS=http://localhost:3000

# Frontend — set at build time for Next.js (the /city page connects to <API>/city/ws)
# NEXT_PUBLIC_API_URL=http://localhost:8000
